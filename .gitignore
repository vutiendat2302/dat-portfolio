# ==============================================================================
# DAT Portfolio — Comprehensive .gitignore
# Stack: Python (FastAPI) + React (Vite/TypeScript) + Docker + MinIO + PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Linters, Formatters & Type Checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Celery / Task queues
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# 3. Node.js & React Frontend (Vite / TypeScript / TailwindCSS)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Production builds
dist/
dist-ssr/
build/
out/

# TypeScript cache
*.tsbuildinfo
.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js / Astro / Vite caches
.vite/
.turbo/
.cache/

# ------------------------------------------------------------------------------
# 4. Database, Local Storage & Uploads
# ------------------------------------------------------------------------------
# SQLite (if used locally)
*.sqlite
*.sqlite3
*.db

# Local media / static uploads (Local testing before S3/MinIO)
uploads/
media/
storage/
temp_uploads/

# MinIO / Docker persistent local data
minio_data/
postgres_data/
data/

# ------------------------------------------------------------------------------
# 5. IDEs, Code Editors & Tooling
# ------------------------------------------------------------------------------
# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Vim / Emacs
*~
*.swp
*.swo
.#*
\#*#

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
