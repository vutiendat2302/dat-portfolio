# URL gốc dùng cho canonical URL, sitemap và robots.txt.
# Đặt thành domain thật trong Vercel khi deploy production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio API Key (cho lệnh npm run translate)
# Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
# Tùy chọn model (mặc định: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
